# ==============================================================================
# Cinepvq Environment Configuration Example
# Copy this file to .env or .env.local for local development.
# ==============================================================================

# PostgreSQL Connection String (Local Docker Compose or Cloud SQL)
# Local Docker development default:
DATABASE_URL=postgresql://cinepvq_user:cinepvq_dev_password@localhost:5432/cinepvq

# Google Cloud SQL (Future Phase Example):
# DATABASE_URL=postgresql://DB_USER:DB_PASSWORD@127.0.0.1:5432/cinepvq?sslmode=require

# Upstream Movie API (NguonC)
NGUONC_API_URL=https://phim.nguonc.com/api
NEXT_PUBLIC_NGUONC_API_URL=https://phim.nguonc.com/api/
